__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Polymarket raw cache: the full resolved-market census + per-token price
# history runs into multiple GB (hundreds of thousands of small markets,
# unlike the Hyperliquid funding cache). Kept out of git; re-fetch via
# scripts/run_polymarket_final_pct.py (populates data/raw/polymarket/ from
# the live public APIs, cached to disk for subsequent local runs).
data/raw/polymarket/

# football-data.co.uk closing-line cache (~15MB, 117 CSVs): free, public,
# deterministic download. Kept out of git; re-fetch via
# scripts/download_football_data.py.
data/football_data/

# tennis-data.co.uk odds cache (~45 files): same deal, re-fetch via
# scripts/download_tennis_data.py.
data/tennis_data/

# PolyOrderbooks' open Zenodo L2 order-book archive (~45MB, 3 parquet files,
# CC BY 4.0, no account needed -- https://doi.org/10.5281/zenodo.22084114).
# Third-party data, not Polymarket's own API, so it lives outside
# data/raw/polymarket/; re-fetch via scripts/calibrate_against_real_l2.py.
data/raw/polyorderbooks_l2/

# Secrets: this repo is public on GitHub. Never commit private keys, API
# keys/secrets/passphrases, or wallet material under any name/extension.
.env
.env.*
!.env.example
*secret*
*private_key*
*.pem
*.key
polymarket_creds*
