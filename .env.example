# Copy this file to .env and fill in real values there.
# .env is gitignored -- never commit real credentials to this repo (it's public on GitHub).

# Your Brave Wallet private key: open Brave Wallet -> select the account
# used to sign into Polymarket -> triple-dot menu -> Account Details ->
# Export Private Key -> enter your wallet password.
POLYMARKET_PRIVATE_KEY=

# Your Polymarket proxy wallet address (NOT your raw Brave Wallet address)
# -- shown on your Polymarket profile page, this is the address your USDC
# balance is actually held at.
POLYMARKET_PROXY_ADDRESS=

# PolyOrderbooks (polyorderbooks.com) API key, for real historical L2
# order-book data -- get one at https://polyorderbooks.com. Free "starter"
# plan: 60 req/min, 7-day retention, crypto Up/Down markets only. See
# src/polyorderbooks_client.py and docs/mm_strategy_methodology.md Section 11.
POLYORDERBOOKS_API_KEY=
